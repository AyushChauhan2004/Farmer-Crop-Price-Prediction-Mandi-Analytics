   "metadata": {},
   "outputs": [],
   "source": [
    "# == Import Libraries ==\n",
    "from pathlib import Path\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "\n",
    "pd.set_option(\"display.max_columns\", 100)\n",
    "pd.set_option(\"display.max_rows\", 50)\n",
    "sns.set_style(\"whitegrid\")\n",
    "%matplotlib inline"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# == Load Dataset ==\n",
    "
    "df = pd.read_csv("sample_csv")\n",
    "print(\"Rows:\", df.shape[0], \"| Columns:\", df.shape[1])\n",
    "df.head()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# == Data Overview ==\n",
    "print(\"Shape:\", df.shape)\n",
    "print(\"\\nColumns:\", df.columns.tolist())\n",
    "display(df.dtypes)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# == Missing Values ==\n",
    "missing = df.isnull().sum()\n",
    "missing_df = pd.DataFrame({\n",
    "    \"Column\": missing.index,\n",
    "    \"Missing Values\": missing.values,\n",
    "    \"Missing %\": np.round((missing.values / len(df)) * 100, 2)\n",
    "}).sort_values(by=\"Missing Values\", ascending=False)\n",
    "\n",
    "display(missing_df)\n",
    "\n",
    "plt.figure(figsize=(10, 5))\n",
    "sns.barplot(data=missing_df, x=\"Missing Values\", y=\"Column\", hue=\"Column\", palette=\"mako\", legend=False)\n",
    "plt.title(\"Missing Values in Dataset\")\n",
    "plt.xlabel(\"Count\")\n",
    "plt.ylabel(\"Column\")\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# == Duplicate Records ==\n",
    "duplicates = df.duplicated().sum()\n",
    "print(\"Duplicate Rows:\", duplicates)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# == Column Standardization ==\n",
    "df.columns = df.columns.str.lower().str.strip().str.replace(\" \", \"_\").str.replace(\"-\", \"_\")\n",
    "\n",
    "column_mapping = {\n",
    "    \"arrival_date\": \"date\",\n",
    "    \"state_name\": \"state\",\n",
    "    \"district_name\": \"district\",\n",
    "    \"market_name\": \"market\",\n",
    "    \"commodity\": \"crop\",\n",
    "    \"minimum_price\": \"min_price\",\n",
    "    \"maximum_price\": \"max_price\",\n",
    "    \"model_price\": \"modal_price\",\n",
    "    \"min_x0020_price\": \"min_price\",\n",
    "    \"max_x0020_price\": \"max_price\",\n",
    "    \"modal_x0020_price\": \"modal_price\"\n",
    "}\n",
    "df.rename(columns=column_mapping, inplace=True)\n",
    "\n",
    "required_columns = [\"date\", \"state\", \"district\", \"market\", \"crop\", \"variety\", \"grade\", \"min_price\", \"max_price\", \"modal_price\"]\n",
    "df = df[[col for col in required_columns if col in df.columns]].copy()\n",
    "df.head()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# == Data Cleaning ==\n",
    "if \"date\" in df.columns:\n",
    "    df[\"date\"] = pd.to_datetime(df[\"date\"], format=\"%d/%m/%Y\", errors=\"coerce\")\n",
    "\n",
    "price_cols = [\"min_price\", \"max_price\", \"modal_price\"]\n",
    "for col in price_cols:\n",
    "    if col in df.columns:\n",
    "        df[col] = pd.to_numeric(df[col], errors=\"coerce\")\n",
    "\n",
    "text_cols = [\"state\", \"district\", \"market\", \"crop\", \"variety\", \"grade\"]\n",
    "for col in text_cols:\n",
    "    if col in df.columns:\n",
    "        df[col] = df[col].astype(str).str.strip().str.title()\n",
    "\n",
    "df.drop_duplicates(inplace=True)\n",
    "print(\"Cleaned Shape:\", df.shape)\n",
    "df.head()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# == Feature Engineering ==\n",
    "if \"date\" in df.columns and pd.api.types.is_datetime64_any_dtype(df[\"date\"]):\n",
    "    df[\"year\"] = df[\"date\"].dt.year\n",
    "    df[\"month\"] = df[\"date\"].dt.month\n",
    "    df[\"month_name\"] = df[\"date\"].dt.month_name()\n",
    "    df[\"quarter\"] = df[\"date\"].dt.quarter\n",
    "    df[\"day_name\"] = df[\"date\"].dt.day_name()\n",
    "\n",
    "if \"max_price\" in df.columns and \"min_price\" in df.columns:\n",
    "    df[\"price_spread\"] = df[\"max_price\"] - df[\"min_price\"]\n",
    "\n",
    "if \"modal_price\" in df.columns and \"min_price\" in df.columns:\n",
    "    df[\"premium_percent\"] = np.where(\n",
    "        df[\"min_price\"] > 0,\n",
    "        ((df[\"modal_price\"] - df[\"min_price\"]) / df[\"min_price\"]) * 100,\n",
    "        np.nan\n",
    "    )\n",
    "\n",
    "df[[\"date\", \"crop\", \"min_price\", \"max_price\", \"modal_price\", \"price_spread\", \"premium_percent\"]].head()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# == Outlier Detection ==\n",
    "plt.figure(figsize=(10, 4))\n",
    "sns.boxplot(x=df[\"modal_price\"], color=\"skyblue\")\n",
    "plt.title(\"Outliers in Modal Price\")\n",
    "plt.xlabel(\"Modal Price (₹)\")\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# == Top 10 Most Expensive Crops ==\n",
    "crop_price = df.groupby(\"crop\")[\"modal_price\"].mean().sort_values(ascending=False).head(10).reset_index()\n",
    "\n",
    "plt.figure(figsize=(12, 6))\n",
    "sns.barplot(data=crop_price, x=\"modal_price\", y=\"crop\", hue=\"crop\", palette=\"viridis\", legend=False)\n",
    "plt.title(\"Top 10 Crops by Average Price\")\n",
    "plt.xlabel(\"Average Modal Price (₹/Quintal)\")\n",
    "plt.ylabel(\"Crop\")\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# == Monthly Price Trend ==\n",
    "monthly_price = df.groupby([\"month\", \"month_name\"])[\"modal_price\"].mean().reset_index().sort_values(\"month\")\n",
    "\n",
    "plt.figure(figsize=(10, 5))\n",
    "sns.lineplot(data=monthly_price, x=\"month_name\", y=\"modal_price\", marker=\"o\", color=\"teal\", linewidth=2.5)\n",
    "plt.title(\"Monthly Average Price Trend\")\n",
    "plt.xlabel(\"Month\")\n",
    "plt.ylabel(\"Average Modal Price (₹/Quintal)\")\n",
    "plt.xticks(rotation=45)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# == State-Wise Average Prices ==\n",
    "state_price = df.groupby(\"state\")[\"modal_price\"].mean().sort_values(ascending=False).head(15).reset_index()\n",
    "\n",
    "plt.figure(figsize=(12, 6))\n",
    "sns.barplot(data=state_price, x=\"modal_price\", y=\"state\", hue=\"state\", palette=\"magma\", legend=False)\n",
    "plt.title(\"Top 15 States by Average Crop Price\")\n",
    "plt.xlabel(\"Average Modal Price (₹/Quintal)\")\n",
    "plt.ylabel(\"State\")\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# == Correlation Heatmap ==\n",
    "numerical_cols = [\"min_price\", \"max_price\", \"modal_price\", \"price_spread\", \"premium_percent\"]\n",
    "corr_matrix = df[[col for col in numerical_cols if col in df.columns]].corr()\n",
    "\n",
    "plt.figure(figsize=(8, 6))\n",
    "sns.heatmap(corr_matrix, annot=True, cmap=\"coolwarm\", fmt=\".2f\", linewidths=0.5)\n",
    "plt.title(\"Price Correlation Heatmap\")\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# == Save Clean Dataset ==\n",
    "PROCESSED_PATH = PROJECT_ROOT / \"data\" / \"processed\" / \"mandi_prices_clean.csv\"\n",
    "PROCESSED_PATH.parent.mkdir(parents=True, exist_ok=True)\n",
    "df.to_csv(PROCESSED_PATH, index=False)\n",
    "print(\"Clean dataset saved to:\", PROCESSED_PATH)"
   ]
  }
 ],
